# API Keys and Configuration
# Copy this file to .env and fill in your actual values

# ── Local ASR Service ────────────────────────────────────────
STT_URL=https://aigc.bosch.com.cn/llmservice/api/v1
STT_APP_ID=your-app-id-here
STT_API_KEY=your-api-key-here
STT_API_SECRET=your-model-name-here

# ── Local LLM Service (MLX) ──────────────────────────────────
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL_NAME=mlx-community/Qwen3.6-27B-4bit
LLM_API_KEY=

# ── Cloud LLM Service (Backup) ───────────────────────────────
# Uncomment below to use cloud service instead of local model
# LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# LLM_MODEL_NAME=GLM-4.5-Air
# LLM_API_KEY=your-cloud-api-key-here

# ── UI Configuration ─────────────────────────────────────────
# HOTKEY=cmd+r
# UI_OPACITY=0.85
